name: Disable auto-merge on new commits

on:
  pull_request_target:
    types: [synchronize]

jobs:
  disable-auto-merge:
    runs-on: ubuntu-latest
    steps:
      - name: Disable auto-merge
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PR_URL: ${{ github.event.pull_request.html_url }}
        run: |
          gh pr merge "$PR_URL" --disable-auto
