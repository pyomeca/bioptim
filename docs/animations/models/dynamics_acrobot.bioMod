version 4

// Double pendulum of bioptim/examples/models/double_pendulum.bioMod (no mesh) plus torque actuators, needed by
// TorqueActivationBiorbdModel (activation in [-1, 1] times Tmax). Used by generate_dynamics_data.py.
segment Seg1
    rotations	x
    ranges
        -10*pi 10*pi
    mass 1
    inertia
        0.0391  0.0000	0.0000
	    0.0000	0.0335	-0.0032
	    0.0000	-0.0032	0.0090
    com  -0.0005 0.0688 -0.9542
endsegment

    marker marker_2
        parent Seg1
        position 0 0 -1
    endmarker

segment Seg2
    parent Seg1
    rotations	x
    rtinmatrix 0
    rt 0 0 0 xyz 0 0 -1
    ranges
        -pi/2 pi/2
    mass 1
    inertia
        0.0391  0.0000	0.0000
	    0.0000	0.0335	-0.0032
	    0.0000	-0.0032	0.0090
    com  -0.0005 0.0688 -0.9542
endsegment

    marker marker_4
        parent Seg2
        position 0 0 -1
    endmarker

    actuator    Seg1
        type    Constant
        dof    RotX
        direction    positive
        Tmax    20.000000
    endactuator
    actuator    Seg1
        type    Constant
        dof    RotX
        direction    negative
        Tmax    20.000000
    endactuator
    actuator    Seg2
        type    Constant
        dof    RotX
        direction    positive
        Tmax    20.000000
    endactuator
    actuator    Seg2
        type    Constant
        dof    RotX
        direction    negative
        Tmax    20.000000
    endactuator
